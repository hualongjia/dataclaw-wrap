# agent-os-service PORT
PORT=5000
# JSON 与表单请求体大小上限；文件上传使用独立的 multipart 限制
REQUEST_BODY_LIMIT="10mb"

# ==================== PostgreSQL ====================
# SeaboxSQL 数据库配置
DATABASE_URL="postgresql://seaboxsql:P@ssw0rd@10.1.2.42:7300/samatrix?schema=samatrix_auth3_new"
# Redis 连接，WebAdmin 和用户 Web 会话使用第 2 号库。
DATACLAW_REDIS_URL="redis://:P%40ssw0rd@10.1.2.212:30003/2"

# ==================== 浏览器来源与 Cookie ====================
# Cookie
# 两端浏览器来源（仅协议、主机及端口，不带路径或末尾斜杠），须与对应 OAuth 回调一致。
DATACLAW_WEBADMIN_ORIGIN="http://localhost:5002,http://127.0.0.1:5002"
DATACLAW_WEB_ORIGIN="http://localhost:5001,http://127.0.0.1:5001"
# CORS 来源白名单，逗号分隔，必须包含上述两端来源。
DATACLAW_CORS_ALLOWED_ORIGINS="http://localhost:5002,http://127.0.0.1:5002,http://localhost:5001,http://127.0.0.1:5001"
# HTTPS 环境设为 true；本地 HTTP 开发可设为 false。
COOKIE_SECURE="false"
# 可选 lax、strict、none。需要跨站携带 Cookie 时用 none，并同时设置 COOKIE_SECURE=true。
COOKIE_SAME_SITE="lax"
# 留空仅绑定写入 Cookie 的主机。需在受信任的同站子域间共享时填共同父域，不带协议或端口。
COOKIE_DOMAIN=""

# 独立会话（多实例配置保持一致）
DATACLAW_ADMIN_SESSION_COOKIE_NAME="dataclaw_admin_session"
DATACLAW_WEB_SESSION_COOKIE_NAME="dataclaw_web_session"
# 浏览器会话固定期限（分钟），活动及切租户均沿用登录时的截止时间。
DATACLAW_SESSION_MAX_MINUTES=1440
DATACLAW_SESSION_REDIS_PREFIX="dataclaw:local:session:"
DATACLAW_SESSION_SECRET="02505488f7c90bf7e144e0f22715e0876c074d4f370855c665eae31444a579d2"

# ==================== Auth3 配置 ====================
# Auth3：三套授权码 Client 均要求 PKCE S256；凭证仅部署在服务端
# 按环境填写 Auth3 Issuer，保留部署前缀（例如 /auth2），不要附加 /oauth/token。
AUTH_BASE_URL="http://auth3-service.dev.jinxin.cloud/auth2"
# 用户端 Web：填写独立 Client ID 和 Secret；回调须与 Auth3 白名单完全一致，并启用 PKCE S256。
OAUTH_WEB_CLIENT_ID="DTn97Axwp8ABjQJXM1YmlriR"
OAUTH_WEB_CLIENT_SECRET="2]=+8KVt?[;EC1_=A{NmH7qcMXG5xR_7mNF7gnm5DH38z;?@"
OAUTH_WEB_REDIRECT_URI="http://localhost:5001/auth/callback"
OAUTH_WEB_POST_LOGOUT_REDIRECT_URI="http://localhost:5001/auth/logout/callback"
# Scope 留空时不主动请求；TOKEN_STRATEGY 填 fixed 或 sliding，须与 Auth3 策略一致。
OAUTH_WEB_SCOPE="openid all read write"
OAUTH_WEB_TOKEN_STRATEGY="sliding"
# 桌面端：填写独立 Client ID 和 Secret；回调使用 dataclaw://auth/callback，并启用 PKCE S256。
OAUTH_DESKTOP_CLIENT_ID="YG9gK1EBxfXuQDTkk2AnnfL5"
OAUTH_DESKTOP_CLIENT_SECRET="}VZ}FR0geB-)f2Jy[vWMYy_e3RSssPDQt@\$f0o(zGgMz8[L["
OAUTH_DESKTOP_REDIRECT_URI="dataclaw://auth/callback"
OAUTH_DESKTOP_SCOPE="openid all read write"
OAUTH_DESKTOP_TOKEN_STRATEGY="sliding"
# 管理端 Web：填写独立 Client ID 和 Secret；回调须与 Auth3 白名单完全一致，并启用 PKCE S256。
OAUTH_ADMIN_CLIENT_ID="5quXws87wm4USzXBIA9zkGse"
OAUTH_ADMIN_CLIENT_SECRET="V)m]C3%RO&Lz)Kb\$*2!Ai([)0muwp&#xIf0oP@#*!QE-pm4Y"
OAUTH_ADMIN_REDIRECT_URI="http://localhost:5002/auth/callback"
OAUTH_ADMIN_POST_LOGOUT_REDIRECT_URI="http://localhost:5002/auth/logout/callback"
OAUTH_ADMIN_SCOPE="openid all read write"
OAUTH_ADMIN_TOKEN_STRATEGY="sliding"
# 独立机器 Client；须登记自省、人员、目录、租户、邮件创建与邮件任务查询权限
# 填写独立 client_credentials 凭证，按环境授予所需平台接口和租户访问权限。
OAUTH_ADMIN_MACHINE_CLIENT_ID="N2VwhbcwQrPOaMMLpWnpvUfk"
