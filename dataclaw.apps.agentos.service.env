# ==================== 数据库 Tool 配置====================
# 必须是与 Base Java AES/ECB/PKCS5Padding 协议一致的 UTF-8 32 字节原始密钥
DATA_SOURCE_PASSWORD_SECRET_KEY="cQzZb2kfkZe0UpJ+sC0Du07#M2QgS6@O"
# 任务专用连接的进程级上限，默认 4，最大 10
DATABASE_TOOL_MAX_CONNECTIONS="4"
# 建立数据库连接的超时时间（毫秒）
DATABASE_TOOL_CONNECT_TIMEOUT_MS="10000"
# 单条 SQL 执行超时时间（毫秒），最大 30000
DATABASE_TOOL_STATEMENT_TIMEOUT_MS="30000"
# 目标数据库要求可信 TLS 证书时启用
DATABASE_TOOL_TLS="false"
# 公共数据库工具优先使用 DATABASE_*；缺失时兼容读取 DATABASE_TOOL_*。
DATABASE_MAX_CONNECTIONS="4"
DATABASE_CONNECT_TIMEOUT_MS="10000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"
DATABASE_TLS="false"
# operation plan 业务值短期 AES-GCM 加密密钥；生产环境使用随机密钥并在所有实例保持一致
DATABASE_OPERATION_PAYLOAD_SECRET_KEY="UiR9TZs7ZfK5JTCKHVpvaYOQDbKkp9d1zktCwqUEihc="
# 默认所有写操作都需用户确认；仅在完成安全验收后按需放开
DATABASE_AUTO_EXECUTE_CREATE="false"
DATABASE_AUTO_EXECUTE_INSERT_MAX_ROWS="0"

