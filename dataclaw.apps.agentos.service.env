# Auth3 管理应用编码，同时用于 Base 数据源归属；必须与登记的 applicationCode 一致。
DATACLAW_WEBADMIN_APPLICATION_CODE="dataclaw-admin-localhost"
AUTH3_EMAIL_TIMEOUT_MS="30000"
# 联调核对完成后启用；间隔默认 30 分钟
