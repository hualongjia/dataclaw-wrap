# ==================== 加密配置====================
# SM4 国密秘钥(16 字节 32个字符)
APPLICATION_API_KEY_SM4_KEY="0123456789abcdef"
# 用户供应商 API Key 独立 SM4 密钥（UTF-8 编码恰好 16 字节，生产环境不得与 Application AppKey 共用）
USER_PROVIDER_API_KEY_SM4_KEY="fedcba9876543210"
# AppKey HMAC 摘要秘钥(32 字节, 64个字符)
APPLICATION_API_KEY_HMAC_SECRET="replace-with-a-random-32-byte-secret"

